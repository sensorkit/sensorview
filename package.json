{
  "name": "sensorview",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -s first -n VITE,ELECTRON -c blue,magenta \"vite\" \"wait-on tcp:5173 && cross-env-shell VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "sidecar:build": "bash scripts/build-sidecar.sh",
    "copy-js9": "node scripts/copy-js9.mjs",
    "postinstall": "node scripts/copy-js9.mjs"
  },
  "dependencies": {
    "@types/d3-selection": "^3.0.11",
    "@types/leaflet": "^1.9.21",
    "astronomy-engine": "^2.1.19",
    "d3-geo": "^3.1.1",
    "d3-quadtree": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "electron-window-state": "^5.0.3",
    "hls.js": "^1.6.16",
    "js9": "^3.9.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.14.1",
    "satellite.js": "^5.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.0",
    "vite": "^6.3.1",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.sensorkit.sensorview",
    "productName": "SensorView",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "sensorview-api-*",
          "mediamtx-*",
          "mediamtx.yml"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "SensorKit <noreply@sensorkit.local>",
      "category": "Education",
      "executableName": "sensorview",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "identity": null,
      "icon": "build/icon.png"
    }
  }
}
